---
import SiteLayout from '../layouts/SiteLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('duyurular'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faqItems = [
  {
    question:
      'Firmam ürün üretmiyor, sadece ithalat yapıyor. Sorumlu teknik eleman istihdam etmem gerekli midir?',
    answerHtml: `
      <p>Kozmetik Yönetmeliği Madde 13'e göre üreticinin uygun seviyede profesyonel yeterliğe sahip bir sorumlu teknik eleman bulundurması gerekir.</p>
      <blockquote>
        <strong>Üretici tanımı (Madde 4):</strong> Bir ürünü üreten, imal eden, ıslah eden veya ürüne adını koymak suretiyle kendini üretici olarak tanıtan gerçek veya tüzel kişiyi; üreticinin Türkiye dışında olması halinde ithalatçıyı ifade eder.
      </blockquote>
      <p>Bu kapsamda kozmetik ürün <strong>imal eden ve/veya ithal eden</strong> tüm firmalar sorumlu teknik eleman istihdam etmek zorundadır.</p>
    `,
  },
  {
    question: 'Sorumlu teknik eleman olma şartları nelerdir?',
    answerHtml: `
      <p>Kozmetik Yönetmeliği Madde 13'e göre:</p>
      <blockquote>
        <strong>Eczacı</strong> veya kozmetik alanında iki yıl fiilen çalışmış olduğunu belgelemek kaydıyla <strong>kimyager, biyokimyager, kimya mühendisi, biyolog veya mikrobiyolog</strong> sorumlu teknik eleman olarak görevlendirilebilir.
      </blockquote>
      <p>Sorumlu teknik eleman, piyasaya arz edilecek ürünün kozmetik mevzuatı, iyi imalat uygulamaları ve ilgili diğer mevzuata uygunluğunun kontrolünden sorumludur.</p>
    `,
  },
  {
    question: 'Ürün Güvenlilik Değerlendirme Raporunu kimler hazırlayabilir?',
    answerHtml: `
      <p>Kozmetik Yönetmeliği Madde 12'ye göre kozmetik ürün güvenlilik değerlendirmesi:</p>
      <blockquote>
        <strong>Eczacılık diplomasına</strong> sahip bir kişi tarafından veya <strong>tıp, diş hekimliği, biyoloji, kimya, biyokimya, mikrobiyoloji veya eşdeğer diplomaya sahip</strong> toksikoloji dalında veya kozmetik ürün güvenlilik değerlendirmesi alanında sunulan teorik ve uygulamalı müfredat programını tamamlayanlara verilen bir belgeye sahip kişi tarafından yapılır.
      </blockquote>
    `,
  },
  {
    question: 'ÜTS kaydı olmadan ürün bildirimi yapılabilir mi?',
    answerHtml: `
      <p>Hayır. Ürün Takip Sistemi'ne ürün bildirimi yapabilmek için öncelikle firmanızın sisteme kayıtlı olması ve gerekli yetki belgelerine sahip olması gerekmektedir. Kayıt sürecini tamamlamadan yapılan bildirimler geçersiz sayılır.</p>
    `,
  },
];

function formatDate(date: Date) {
  return date.toLocaleDateString('tr-TR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

<SiteLayout
  title="Dese Consulting | Ürün Takip Sistemi ve Mevzuat Danışmanlığı"
  description="Dese Consulting - Ürün Takip Sistemi kayıt, ürün bildirimi, sorumlu teknik eleman ve mevzuat danışmanlığı hizmetleri."
  canonical="https://www.deseconsulting.com/"
>
  <main id="main">
    <section class="hero" id="anasayfa">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <p class="hero-brand reveal">Dese Consulting</p>
        <h1 class="reveal reveal-delay-1">Ürün Takip Sistemi ve mevzuat danışmanlığı</h1>
        <p class="hero-desc reveal reveal-delay-2">
          Kozmetik, tıbbi cihaz ve gıda sektöründe ÜTS kayıt, ürün bildirimi ve sorumlu teknik eleman süreçlerinizde yanınızdayız.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="#iletisim" class="btn btn-accent">Ücretsiz Danışmanlık</a>
          <a href="#hizmetler" class="btn btn-ghost">Hizmetlerimiz</a>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Güven göstergeleri">
      <div class="container trust-grid">
        <div class="trust-item reveal"><strong>500+</strong><span>Başarılı ÜTS başvurusu</span></div>
        <div class="trust-item reveal"><strong>10+</strong><span>Yıllık deneyim</span></div>
        <div class="trust-item reveal"><strong>200+</strong><span>Danışılan firma</span></div>
        <div class="trust-item reveal"><strong>TİTCK</strong><span>Mevzuat uyumu</span></div>
      </div>
    </section>

    <section class="about" id="hakkimizda">
      <div class="container about-grid">
        <div class="about-visual reveal" aria-hidden="true">
          <div class="about-panel">
            <svg class="icon-xl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>
          </div>
        </div>
        <div class="about-content reveal">
          <p class="section-label">Hakkımızda</p>
          <h2>Regülasyon süreçlerinizde güvenilir partneriniz</h2>
          <p>
            Dese Consulting olarak kozmetik, tıbbi cihaz ve gıda sektöründeki firmaların
            Ürün Takip Sistemi (ÜTS) kayıt, ürün bildirimi ve mevzuat uyum süreçlerinde
            profesyonel destek sunuyoruz.
          </p>
          <p>
            TİTCK mevzuatına hakim uzman kadromuzla yasal yükümlülüklerinizi eksiksiz
            yerine getirmenizi sağlıyor; denetimlere hazır olmanız için yanınızda duruyoruz.
          </p>
          <ul class="about-points">
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 15l2 2 4-4"></path></svg>
              <div><strong>Mevzuat takibi</strong><span>Güncel TİTCK duyuruları</span></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
              <div><strong>Hızlı süreç</strong><span>Etkin başvuru yönetimi</span></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <div><strong>Uyum odaklı</strong><span>Denetimlere hazırlık</span></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <div><strong>Uzman kadro</strong><span>Alanında deneyimli ekip</span></div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section id="hizmetler" class="services">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-label">Danışmanlık alanlarımız</p>
          <h2>Sunduğumuz hizmetler</h2>
          <p>ÜTS ve mevzuat süreçlerinizde ihtiyaç duyduğunuz danışmanlığı tek çatı altında sunuyoruz.</p>
        </header>
        <div class="services-list">
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M3.27 6.96L12 12.01l8.73-5.05"></path><path d="M12 22.08V12"></path></svg>
            </div>
            <div class="service-body">
              <h3>ÜTS Ürün Bildirimi</h3>
              <p>Kozmetik ve tıbbi cihaz ürünlerinizin Ürün Takip Sistemi'ne eksiksiz bildirimini sağlıyoruz.</p>
            </div>
            <a href="#iletisim" class="service-link">Bilgi alın</a>
          </article>
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>
            </div>
            <div class="service-body">
              <h3>ÜTS Kayıt Başvurusu</h3>
              <p>Firmanızın Ürün Takip Sistemi'ne kayıt sürecini baştan sona yönetiyoruz.</p>
            </div>
            <a href="#iletisim" class="service-link">Bilgi alın</a>
          </article>
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle><path d="M12 14v3"></path><path d="M9 17h6"></path></svg>
            </div>
            <div class="service-body">
              <h3>Sorumlu Teknik Eleman (STE)</h3>
              <p>Kozmetik mevzuatına uygun STE görevlendirme ve danışmanlık hizmeti.</p>
            </div>
            <a href="/duyurular/sorumlu-teknik-eleman-ve-urun-guvenlilik-degerlendirme-hakkinda-sik-sorulan-sorular/" class="service-link">SSS</a>
          </article>
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path><path d="M11 8v6"></path><path d="M8 11h6"></path></svg>
            </div>
            <div class="service-body">
              <h3>Ürün Güvenlilik Değerlendirme (ÜGDR)</h3>
              <p>Kozmetik ürünleriniz için yasal gerekliliklere uygun güvenlilik değerlendirme raporu.</p>
            </div>
            <a href="#iletisim" class="service-link">Bilgi alın</a>
          </article>
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            </div>
            <div class="service-body">
              <h3>Etiket ve İçerik Kontrolü</h3>
              <p>Ürün etiketlerinizin ve içerik listelerinizin mevzuata uygunluğunu kontrol ediyoruz.</p>
            </div>
            <a href="#iletisim" class="service-link">Bilgi alın</a>
          </article>
          <article class="service-row reveal">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            </div>
            <div class="service-body">
              <h3>Tıbbi Cihaz Danışmanlığı</h3>
              <p>Tıbbi cihaz kayıt, bildirim ve ruhsatlandırma süreçlerinde kapsamlı destek.</p>
            </div>
            <a href="#iletisim" class="service-link">Bilgi alın</a>
          </article>
        </div>
      </div>
    </section>

    <section class="process">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-label">Çalışma sürecimiz</p>
          <h2>Nasıl çalışıyoruz?</h2>
          <p>Şeffaf adımlarla firmanızın mevzuat uyum sürecini yönetiyoruz.</p>
        </header>
        <ol class="process-steps">
          <li class="reveal"><span class="step-num">01</span><h3>İhtiyaç analizi</h3><p>Mevcut durumunuzu ve ihtiyaçlarınızı birlikte değerlendiriyoruz.</p></li>
          <li class="reveal"><span class="step-num">02</span><h3>Planlama</h3><p>Size özel yol haritası ve zaman çizelgesi oluşturuyoruz.</p></li>
          <li class="reveal"><span class="step-num">03</span><h3>Uygulama</h3><p>Başvuru, bildirim ve raporlama süreçlerini yürütüyoruz.</p></li>
          <li class="reveal"><span class="step-num">04</span><h3>Takip ve destek</h3><p>Sürekli mevzuat takibi ve güncelleme desteği sağlıyoruz.</p></li>
        </ol>
      </div>
    </section>

    <section id="sss" class="faq">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-label">Sık sorulan sorular</p>
          <h2>Sorumlu Teknik Eleman ve ÜGDR</h2>
          <p>
            TİTCK Kozmetik Ürünler Dairesi'nin en sık sorulan sorularına yanıtlar.
            <a href="/duyurular/sorumlu-teknik-eleman-ve-urun-guvenlilik-degerlendirme-hakkinda-sik-sorulan-sorular/">Detaylı makaleyi okuyun</a>.
          </p>
        </header>
        <FaqAccordion items={faqItems} />
      </div>
    </section>

    <section class="news" id="duyurular">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-label">Duyurular</p>
          <h2>Son haberler ve mevzuat güncellemeleri</h2>
          <p>TİTCK duyuruları ve sektörel gelişmelerden haberdar olun.</p>
        </header>
        <div class="news-list">
          {
            posts.map((post) => (
              <article class="news-item reveal">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <h3>
                  <a href={`/duyurular/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="referanslar" class="references">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-label">Referanslarımız</p>
          <h2>Güvenen firmalar</h2>
          <p>Farklı sektörlerden firmaların tercih ettiği danışmanlık hizmeti.</p>
        </header>
        <ul class="ref-list">
          <li class="reveal"><strong>Kozmetik firmaları</strong><span>150+</span></li>
          <li class="reveal"><strong>Tıbbi cihaz</strong><span>80+</span></li>
          <li class="reveal"><strong>Takviye edici gıda</strong><span>45+</span></li>
          <li class="reveal"><strong>İthalatçı firmalar</strong><span>60+</span></li>
        </ul>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <h2 id="cta-heading">ÜTS süreçlerinizde profesyonel destek alın</h2>
        <p>Ücretsiz ön değerlendirme için bizimle iletişime geçin.</p>
        <a href="#iletisim" class="btn btn-accent">Hemen iletişime geçin</a>
      </div>
    </section>

    <section id="iletisim" class="contact">
      <div class="container contact-grid">
        <div class="contact-info reveal">
          <p class="section-label">İletişim</p>
          <h2>Bizimle iletişime geçin</h2>
          <p>ÜTS kayıt, ürün bildirimi veya danışmanlık hizmetlerimiz hakkında bilgi almak için formu doldurun ya da doğrudan bize ulaşın.</p>
          <ul class="contact-list">
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <div><strong>Adres</strong><span>İstanbul, Türkiye</span></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <div><strong>Telefon</strong><a href="tel:+905331575686">+90 (533) 157 56 86</a></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="M22 6l-10 7L2 6"></path></svg>
              <div><strong>E-posta</strong><a href="mailto:info@deseconsulting.com">info@deseconsulting.com</a></div>
            </li>
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <div><strong>WhatsApp</strong><a href="https://wa.me/905331575686" target="_blank" rel="noopener noreferrer">+90 (533) 157 56 86</a></div>
            </li>
          </ul>
        </div>

        <form class="contact-form reveal" id="contactForm" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Ad Soyad *</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Adınız Soyadınız" />
            </div>
            <div class="form-group">
              <label for="company">Firma Adı</label>
              <input type="text" id="company" name="company" autocomplete="organization" placeholder="Firma Adınız" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">E-posta *</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="ornek@firma.com" />
            </div>
            <div class="form-group">
              <label for="phone">Telefon *</label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="0 (5XX) XXX XX XX" />
            </div>
          </div>
          <div class="form-group">
            <label for="service">İlgilendiğiniz hizmet</label>
            <select id="service" name="service">
              <option value="">Seçiniz...</option>
              <option value="uts-kayit">ÜTS Kayıt Başvurusu</option>
              <option value="uts-bildirim">ÜTS Ürün Bildirimi</option>
              <option value="ste">Sorumlu Teknik Eleman</option>
              <option value="ugdr">Ürün Güvenlilik Değerlendirme</option>
              <option value="etiket">Etiket ve İçerik Kontrolü</option>
              <option value="tibbi-cihaz">Tıbbi Cihaz Danışmanlığı</option>
              <option value="diger">Diğer</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Mesajınız *</label>
            <textarea id="message" name="message" required placeholder="Talebinizi kısaca açıklayın..."></textarea>
          </div>
          <p class="form-status" id="formStatus" role="status" aria-live="polite" hidden></p>
          <button type="submit" class="btn btn-accent btn-block">Gönder</button>
        </form>
      </div>
    </section>
  </main>
</SiteLayout>
